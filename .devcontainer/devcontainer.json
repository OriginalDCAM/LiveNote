// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  // Container Configuration
  "name": "LiveNote DevContainer",

  // Docker Compose
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.dev.yaml"
  ],
  "service": "dev",
  "runServices": [
    "dev",
    "mongodb",
    "mongo-express"
  ],
  "shutdownAction": "stopCompose",

  "workspaceFolder": "/workspaces/LiveNote",
  // Port forwarding
  "forwardPorts": [
    5173,
    5045,
    7137
  ],
  "portsAttributes": {
    "5173": {
      "label": "Frontend SPA",
      "onAutoForward": "notify",
      "protocol": "http",
    },
    "5045": {
      "label": "Web API (http)",
      "onAutoForward": "notify",
      "protocol": "http",
    },
    "7137": {
      "label": "Web API (http)",
      "onAutoForward": "notify",
      "protocol": "https",
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    }
  },

  "postCreateCommand": "cd LiveNote.SPA && npm ci",
  "remoteUser": "node"
}
